# Generated fixture artifacts. build_fixture.py regenerates them deterministically from the
# campaign source, so the bytes do not belong in git.
examples/pcam/cohort.parquet
examples/pcam/predictions.parquet
examples/pcam/out/

# Same reasoning for GUSTO-I: raw_cache/ is an external fetched input (not a generated
# derivative, and not sensitive -- GUSTO-I is a public dataset), and cohort.parquet/
# predictions.parquet are make_predictions.py's regenerable output.
examples/gusto/raw_cache/
examples/gusto/cohort.parquet
examples/gusto/predictions.parquet
examples/gusto/out/

# Intermediates of the predRupdate reproduce recipe (see validation/predrupdate/README.md).
# gusto_y_p.csv is an export of the GUSTO fixture and must never be committed; the two
# *_estimates.csv are the halves that were merged by hand into the committed
# predrupdate_estimates.csv.
validation/predrupdate/gusto_y_p.csv
validation/predrupdate/synpm_estimates.csv
validation/predrupdate/gusto_estimates.csv

# Same reasoning for the IMPROVE neoepitope fixture: build_fixture.py regenerates both parquets
# deterministically from the released IMPROVE_paper results archive.
examples/improve/cohort.parquet
examples/improve/predictions.parquet
examples/improve/out/
